# Copiez ce fichier en .env et remplissez-le. Ne le versionnez jamais (git, dépôt public).
TELEGRAM_TOKEN=COLLEZ_ICI_LE_TOKEN_BOTFATHER
TELEGRAM_OWNER_ID=123456789

# --- Modules Jarvis (facultatifs : chaque module indique la clé manquante) ---
# E-mails, boîte mail et Google Docs (Gmail API, OAuth)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Alternative pour les e-mails si Gmail n'est pas configuré
BREVO_API_KEY=
BREVO_SENDER=
# SMS (Infobip)
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
INFOBIP_SENDER=KITT
# Recherche web (Tavily)
TAVILY_API_KEY=
# Images (Cloudflare Workers AI)
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# Fuseau horaire
TIMEZONE=Africa/Douala

# Identité de KITT : le nom de la personne qui l'a créé (optionnel, affiché dans sa présentation)
KITT_CREATEUR=
